  "info": {
    "title": "Waflo M1 Staff Mobile API",
    "description": "Mobile-safe subset of the approved W4 backend contract.",
    "version": "w4-m1-contract-v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "StrictSemanticVersion": {
        "type": "string",
        "minLength": 5,
        "maxLength": 40,
        "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
      },
      "DevicePairingClaimRequest": {
        "type": "object",
        "properties": {
          "pairingToken": {
            "type": "string",
            "minLength": 80,
            "maxLength": 512
          },
          "installationId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 160
          },
          "publicKey": {
            "type": "string",
            "minLength": 40,
            "maxLength": 1024
          },
          "platform": {
            "type": "string",
            "enum": [
              "IOS",
              "ANDROID",
              "TEST_CLIENT"
            ]
          },
          "appVersion": {
            "type": "string",
            "minLength": 5,
            "maxLength": 40,
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
          },
          "osVersion": {
            "type": "string",
            "maxLength": 80
          },
          "model": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "pairingToken",
          "installationId",
          "publicKey",
          "platform",
          "appVersion"
        ],
        "additionalProperties": false
      },
      "DevicePairingClaimResponse": {
        "type": "object",
        "properties": {
          "pairingPublicId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "challenge": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "challengeExpiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "signatureAlgorithm": {
            "type": "string",
            "const": "Ed25519"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "pairingPublicId",
          "challenge",
          "challengeExpiresAt",
          "signatureAlgorithm",
          "message"
        ],
        "additionalProperties": false
      },
      "DevicePairingRecoveryRequest": {
        "type": "object",
        "properties": {
          "pairingPublicId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "pairingPublicId"
        ],
        "additionalProperties": false
      },
      "DevicePairingRecoveryResponse": {
        "type": "object",
        "properties": {
          "pairingPublicId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "challenge": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
