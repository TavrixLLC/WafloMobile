{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waflo.app/contracts/m1.schema.json",
  "title": "Waflo W4-to-M1 Mobile Contract",
  "type": "object",
  "$defs": {
    "StrictSemanticVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 40,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "DevicePairingClaimRequest": {
      "type": "object",
      "properties": {
        "pairingToken": {
          "type": "string",
          "minLength": 80,
          "maxLength": 512
        },
        "installationId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 160
        },
        "publicKey": {
          "type": "string",
          "minLength": 40,
          "maxLength": 1024
        },
        "platform": {
          "type": "string",
          "enum": [
            "IOS",
            "ANDROID",
            "TEST_CLIENT"
          ]
        },
        "appVersion": {
          "type": "string",
          "minLength": 5,
          "maxLength": 40,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "osVersion": {
          "type": "string",
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": [
        "pairingToken",
        "installationId",
        "publicKey",
        "platform",
        "appVersion"
      ],
      "additionalProperties": false
    },
    "DevicePairingClaimResponse": {
      "type": "object",
      "properties": {
        "pairingPublicId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "challenge": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        },
        "challengeExpiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "signatureAlgorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "pairingPublicId",
        "challenge",
        "challengeExpiresAt",
        "signatureAlgorithm",
        "message"
      ],
      "additionalProperties": false
    },
    "DevicePairingRecoveryRequest": {
      "type": "object",
      "properties": {
        "pairingPublicId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "pairingPublicId"
      ],
      "additionalProperties": false
    },
    "DevicePairingRecoveryResponse": {
      "type": "object",
      "properties": {
        "pairingPublicId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "challenge": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        },
        "challengeExpiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "signatureAlgorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "pairingPublicId",
        "challenge",
        "challengeExpiresAt",
        "signatureAlgorithm",
        "message"
      ],
      "additionalProperties": false
    },
    "DevicePairingCompleteRequest": {
      "type": "object",
      "properties": {
        "pairingPublicId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "challenge": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        },
        "signature": {
          "type": "string",
          "minLength": 40,
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "pairingPublicId",
        "challenge",
        "signature"
      ],
      "additionalProperties": false
    },
    "DevicePairingCompleteResponse": {
      "type": "object",
      "properties": {
        "device": {
          "type": "object",
          "properties": {
            "publicId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "platform": {
              "type": "string",
              "enum": [
                "IOS",
                "ANDROID",
                "TEST_CLIENT"
              ]
            },
            "status": {
              "type": "string",
              "const": "ACTIVE"
            }
          },
          "required": [
            "publicId",
            "displayName",
            "platform",
            "status"
          ],
          "additionalProperties": false
        },
        "session": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "token": {
              "type": "string",
              "minLength": 40,
              "maxLength": 512
            },
            "refreshToken": {
              "type": "string",
              "minLength": 40,
              "maxLength": 512
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            }
          },
          "required": [
            "id",
            "token",
            "refreshToken",
            "expiresAt"
          ],
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "properties": {
            "organizationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "role": {
              "type": "string",
              "enum": [
                "OWNER",
                "MANAGER",
                "STAFF"
              ]
            },
            "locationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "organizationId",
            "role",
            "locationId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "device",
        "session",
        "context"
      ],
      "additionalProperties": false
    },
    "StaffDeviceSessionRefreshRequest": {
      "type": "object",
      "properties": {
        "refreshToken": {
          "type": "string",
          "minLength": 40,
          "maxLength": 512
        }
      },
      "required": [
        "refreshToken"
      ],
      "additionalProperties": false
    },
    "StaffDeviceSessionRefreshResponse": {
      "type": "object",
      "properties": {
        "session": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "token": {
              "type": "string",
              "minLength": 40,
              "maxLength": 512
            },
            "refreshToken": {
              "type": "string",
              "minLength": 40,
              "maxLength": 512
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            }
          },
          "required": [
            "id",
            "token",
            "refreshToken",
            "expiresAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "session"
      ],
      "additionalProperties": false
    },
    "MobileStaffDeviceContext": {
      "type": "object",
      "properties": {
        "organization": {
          "type": "object",
          "properties": {
            "publicId": {
              "type": "string",
              "minLength": 3,
              "maxLength": 40
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "publicId",
            "displayName"
          ],
          "additionalProperties": false
        },
        "staff": {
          "type": "object",
          "properties": {
            "publicId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "role": {
              "type": "string",
              "enum": [
                "OWNER",
                "MANAGER",
                "STAFF"
              ]
            }
          },
          "required": [
            "publicId",
            "displayName",
            "role"
          ],
          "additionalProperties": false
        },
        "device": {
          "type": "object",
          "properties": {
            "publicId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "status": {
              "type": "string",
              "enum": [
                "PENDING",
                "ACTIVE",
                "REVOKED",
                "COMPROMISED"
              ]
            },
            "platform": {
              "type": "string",
              "enum": [
                "IOS",
                "ANDROID",
                "TEST_CLIENT"
              ]
            },
            "appVersion": {
              "type": "string",
              "minLength": 5,
              "maxLength": 40,
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
            }
          },
          "required": [
            "publicId",
            "displayName",
            "status",
            "platform",
            "appVersion"
          ],
          "additionalProperties": false
        },
        "currentLocation": {
          "type": "object",
          "properties": {
            "publicId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "earningAllowed": {
              "type": "boolean"
            },
            "redemptionAllowed": {
              "type": "boolean"
            }
          },
          "required": [
            "publicId",
            "displayName",
            "earningAllowed",
            "redemptionAllowed"
          ],
          "additionalProperties": false
        },
        "assignedLocations": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "publicId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "earningAllowed": {
                "type": "boolean"
              },
              "redemptionAllowed": {
                "type": "boolean"
              }
            },
            "required": [
              "publicId",
              "displayName",
              "earningAllowed",
              "redemptionAllowed"
            ],
            "additionalProperties": false
          }
        },
        "appPolicy": {
          "type": "object",
          "properties": {
            "minimumSupportedVersion": {
              "type": "string",
              "minLength": 5,
              "maxLength": 40,
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
            },
            "updateRequired": {
              "type": "boolean"
            }
          },
          "required": [
            "minimumSupportedVersion",
            "updateRequired"
          ],
          "additionalProperties": false
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "organization",
        "staff",
        "device",
        "currentLocation",
        "assignedLocations",
        "appPolicy",
        "requestId"
      ],
      "additionalProperties": false
    },
    "RequestSigningFixture": {
      "type": "object",
      "properties": {
        "envelopeVersion": {
          "type": "string",
          "const": "waflo-device-request-v1"
        },
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "canonicalPath": {
          "type": "string",
          "pattern": "^\\/.*"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bodySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "deviceSessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "organizationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "separator": {
          "type": "string",
          "const": "\\n"
        },
        "containsCredential": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "envelopeVersion",
        "algorithm",
        "method",
        "canonicalPath",
        "requestId",
        "timestamp",
        "nonce",
        "bodySha256",
        "deviceSessionId",
        "organizationId",
        "separator",
        "containsCredential"
      ],
      "additionalProperties": false
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "requestId"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
